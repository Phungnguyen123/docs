# Copy this file to .env and fill in your keys. .env is gitignored.
# The tools load it automatically (never type keys into the terminal).

# Google Programmable Search (OFFICIAL, ToS-compliant — recommended over SerpAPI):
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# SerpAPI (third-party Google scraper; optional fallback):
SERPAPI_KEY=

# urlscan.io (optional; increases brand-monitor rate limits):
URLSCAN_API_KEY=

# UK Companies House (only for main_ch.py):
CH_API_KEY=
